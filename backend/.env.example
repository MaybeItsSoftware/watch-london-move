PORT=4010
# Exact origins only — no wildcards, no prefix matching. The two Capacitor
# WebView origins (capacitor://localhost, https://localhost) are always allowed
# and do not need listing here; this is for browsers. For live-reload on a
# physical device, add http://<lan-ip>:5173.
CORS_ORIGIN=http://localhost:5173
POLL_INTERVAL_MS=15000
# What the poller does with nobody connected. A cycle is a ~10s whole-network
# fetch, an ~80MB parse and a reduce over ~120,000 rows; running that for an
# empty audience was measured at 133 polls against zero clients and is most of
# the compute bill on a hobby deployment.
#
# 0 suspends polling entirely while idle — pair it with a platform that sleeps
# idle containers. A client arriving always forces a refresh first, so nothing
# is served stale either way.
IDLE_POLL_INTERVAL_MS=300000
EMIT_INTERVAL_MS=10000
# Defaults to 25000. TfL revises bus predictions on roughly that beat, so
# polling faster costs requests and returns the same numbers.
BUS_CACHE_WINDOW_MS=
TRAIN_CACHE_WINDOW_MS=10000
# --- Bus source ---
# Every bus in London comes from TfL's Countdown/URA interface. It carries the
# same predictions as the Unified API's /Mode/bus/Arrivals — measured, 99.5% of
# matched (vehicle, stop) pairs agree exactly — but lets the caller name the
# fields it wants, so it is 2.07MB on the wire against 8.07MB and 12MB to parse
# against 90MB, and fetches in ~1.2s against 4-11s.
#
# URA is a 2012 interface TfL no longer documents and does not authenticate, and
# it is now the only bus path there is: BUS_FEED_SOURCE and the Unified reader
# were removed once the migration came off trial. A shape change is therefore an
# incident, not a rollback — see ../DEPLOY.md and scripts/soak-check.js.
#
# Note URA rejects TfL API credentials outright: any request carrying
# app_id/app_key answers HTTP 400, which is why it has its own HTTP client.
URA_BASE_URL=https://countdown.api.tfl.gov.uk
# Charing Cross and a radius. The furthest stop in the network is 34.8km out and
# row counts are identical from 40km to 500km, so the margin is free.
URA_CIRCLE=51.5072,-0.1276,60000
URA_TIMEOUT_MS=30000
# A response below this fraction of the previous fleet is treated as a failure
# rather than cached. URA answers 200 with only a header when it has nothing.
BUS_FEED_MIN_RETAINED_FRACTION=0.2
TFL_LINES_PER_REQUEST=5
RETRY_COUNT=3
RETRY_BASE_DELAY_MS=1000
MAX_RETRY_WAIT_MS=10000
STOP_POINT_CACHE_MS=86400000
STOP_POINT_CACHE_PATH=
STOP_POINT_RETRY_MS=300000
STOP_POINT_PAGE_SIZE=1000
# Defaults to 250 with a TFL_APP_KEY set, 1400 without.
STOP_POINT_PAGE_PACE_MS=
STALE_VEHICLE_MS=90000
# Stops per vehicle on the wire, counting the one it is heading for now. Clamped
# to 1..5; 1 sends a single stop as before, which is the setting to reach for if
# egress ever matters more than smooth motion between polls.
SCHEDULE_STOPS=3
FULL_EMIT_EVERY_N=6
ROUTE_SEQUENCE_CACHE_PATH=
ROUTE_SEQUENCE_CACHE_MS=604800000
ROUTE_SEQUENCE_RETRY_MS=600000
# Defaults to 1500 with a TFL_APP_KEY set, 14000 without.
ROUTE_FETCH_PACE_MS=
ROUTE_CHECKPOINT_EVERY=5
ROUTE_SIMPLIFY_TOLERANCE_DEG=0.00008
# --- Streaming and bandwidth ---
# permessage-deflate. socket.io leaves this off by default; these payloads
# compress about 3x. Set to "false" only to measure the difference.
WS_COMPRESSION=true
WS_COMPRESSION_THRESHOLD=512
# HTTP responses, which socket.io's setting above does not touch. /routes is
# 2.69MB uncompressed and 256KB brotli, and Fly's proxy compresses nothing, so
# this is the single largest lever on egress. "false" only to measure it.
HTTP_COMPRESSION=true
# Below this a response costs more in encoding framing than it saves.
HTTP_COMPRESSION_THRESHOLD=1024
# Grid cell for viewport subscriptions, in degrees. Smaller cells scope a
# client's traffic more tightly but cost more rooms and more messages per tick.
TILE_SIZE_DEG=0.05
# A viewport needing more cells than this is served the whole network instead
# of being clipped.
MAX_VIEWPORT_TILES=240
# Grace period for a new socket to declare a viewport before it is assumed to
# want everything.
VIEWPORT_GRACE_MS=3000
# Ceiling on ids per vehicles:details request.
MAX_DETAIL_IDS=50

TFL_API_BASE_URL=https://api.tfl.gov.uk
TFL_APP_ID=
TFL_APP_KEY=
TFL_TRAIN_LINES=bakerloo,central,circle,district,elizabeth,hammersmith-city,jubilee,metropolitan,northern,piccadilly,victoria,waterloo-city,lioness,mildmay,windrush,weaver,suffragette,liberty,dlr,tram

# --- Abuse and access control ---
# Hop count for X-Forwarded-For. Railway's router terminates TLS upstream, so
# without this every client shares one rate-limit bucket and the first busy
# visitor throttles everyone. Not `true`: trusting the whole chain lets a client
# prepend its own header and choose which bucket it lands in.
TRUST_PROXY=1
# Fan-out is single-threaded. fly.toml enforced this with hard_limit = 400;
# Railway has no equivalent, so the process enforces its own.
MAX_CONNECTIONS=400
MAX_CONNECTIONS_PER_IP=12
# Bandwidth, cost and poll metrics on /health, and ?details=1 on /snapshot.
# Unset, /health returns liveness only in production and everything in dev.
# Read as `Authorization: Bearer <token>` or `?token=`.
METRICS_TOKEN=
# Token buckets. Capacity is the burst; refill is the sustained rate per second.
# Per-route costs are in server.js — /snapshot is 20, /routes 10, /stops 2.
RATE_HTTP_CAPACITY=60
RATE_HTTP_REFILL=1
# vehicles:request-full is a tiny message in and a per-tile encode of the whole
# visible fleet out, so it gets the tightest budget of all. The server already
# pushes an unprompted full every FULL_EMIT_EVERY_N ticks.
RATE_FULL_CAPACITY=4
RATE_FULL_REFILL=0.1
# A pan legitimately bursts these while the camera settles.
RATE_VIEWPORT_CAPACITY=40
RATE_VIEWPORT_REFILL=2
RATE_DETAILS_CAPACITY=20
RATE_DETAILS_REFILL=2
