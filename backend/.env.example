PORT=4010
# Exact origins only — no wildcards, no prefix matching. The two Capacitor
# WebView origins (capacitor://localhost, https://localhost) are always allowed
# and do not need listing here; this is for browsers. For live-reload on a
# physical device, add http://<lan-ip>:5173.
CORS_ORIGIN=http://localhost:5173
POLL_INTERVAL_MS=15000
EMIT_INTERVAL_MS=10000
# Defaults to 25000 when tracking every route (the whole-network feed is large),
# 10000 when TFL_BUS_LINES names a subset.
BUS_CACHE_WINDOW_MS=
TRAIN_CACHE_WINDOW_MS=10000
# The whole-network bus feed takes ~10s to transfer.
BUS_FEED_TIMEOUT_MS=60000
TFL_LINES_PER_REQUEST=5
RETRY_COUNT=3
RETRY_BASE_DELAY_MS=1000
MAX_RETRY_WAIT_MS=10000
STOP_POINT_CACHE_MS=86400000
STOP_POINT_CACHE_PATH=
STOP_POINT_RETRY_MS=300000
STOP_POINT_PAGE_SIZE=1000
# Defaults to 250 with a TFL_APP_KEY set, 1400 without.
STOP_POINT_PAGE_PACE_MS=
STALE_VEHICLE_MS=90000
# Stops per vehicle on the wire, counting the one it is heading for now. Clamped
# to 1..5; 1 sends a single stop as before, which is the setting to reach for if
# egress ever matters more than smooth motion between polls.
SCHEDULE_STOPS=3
FULL_EMIT_EVERY_N=6
ROUTE_SEQUENCE_CACHE_PATH=
ROUTE_SEQUENCE_CACHE_MS=604800000
ROUTE_SEQUENCE_RETRY_MS=600000
# Defaults to 1500 with a TFL_APP_KEY set, 14000 without.
ROUTE_FETCH_PACE_MS=
ROUTE_CHECKPOINT_EVERY=5
ROUTE_SIMPLIFY_TOLERANCE_DEG=0.00008
# --- Event loop ---
# The whole-network bus feed is ~80MB of JSON. Its request, its JSON.parse and
# the reduce over ~120,000 rows all run on a worker thread, so a poll no longer
# stops the event loop — and with it every delta emit, health check and
# WebSocket ping — for the duration. "false" runs the identical code in process,
# which is also the automatic fallback if the thread cannot start; /health
# reports which is in use.
BUS_FEED_WORKER=true
# --- Streaming and bandwidth ---
# permessage-deflate. socket.io leaves this off by default; these payloads
# compress about 3x. Set to "false" only to measure the difference.
WS_COMPRESSION=true
WS_COMPRESSION_THRESHOLD=512
# HTTP responses, which socket.io's setting above does not touch. /routes is
# 2.69MB uncompressed and 256KB brotli, and Fly's proxy compresses nothing, so
# this is the single largest lever on egress. "false" only to measure it.
HTTP_COMPRESSION=true
# Below this a response costs more in encoding framing than it saves.
HTTP_COMPRESSION_THRESHOLD=1024
# Grid cell for viewport subscriptions, in degrees. Smaller cells scope a
# client's traffic more tightly but cost more rooms and more messages per tick.
TILE_SIZE_DEG=0.05
# A viewport needing more cells than this is served the whole network instead
# of being clipped.
MAX_VIEWPORT_TILES=240
# Grace period for a new socket to declare a viewport before it is assumed to
# want everything.
VIEWPORT_GRACE_MS=3000
# Ceiling on ids per vehicles:details request.
MAX_DETAIL_IDS=50

TFL_API_BASE_URL=https://api.tfl.gov.uk
TFL_APP_ID=
TFL_APP_KEY=
# Leave unset to track every London bus route via the whole-network feed
# (/Mode/bus/Arrivals). Set a comma-separated list to poll only those routes.
TFL_BUS_LINES=
TFL_TRAIN_LINES=bakerloo,central,circle,district,elizabeth,hammersmith-city,jubilee,metropolitan,northern,piccadilly,victoria,waterloo-city,lioness,mildmay,windrush,weaver,suffragette,liberty,dlr,tram
