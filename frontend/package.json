{
  "name": "frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "icons": "node scripts/generate-icons.mjs",
    "assets": "npx --yes @capacitor/assets generate --ios --android --iconBackgroundColor '#0b0f1a' --iconBackgroundColorDark '#0b0f1a' --splashBackgroundColor '#0b0f1a' --splashBackgroundColorDark '#0b0f1a'",
    "models": "node scripts/generate-models/index.mjs",
    "static-data": "node scripts/generate-static-data.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@deck.gl/core": "^9.3.7",
    "@deck.gl/layers": "^9.3.7",
    "@deck.gl/mapbox": "^9.3.7",
    "@deck.gl/mesh-layers": "^9.3.7",
    "@loaders.gl/core": "^4.4.4",
    "@loaders.gl/gltf": "^4.4.4",
    "@sentry/react": "^10.70.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
