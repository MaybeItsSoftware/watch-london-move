# Production build config. Vite inlines these at build time, so a shipped app
# binary is permanently pinned to whatever host was set here when it was built —
# changing the backend URL later means a rebuild and, for the native apps, a
# store resubmission. Set this before `npm run sync`.
#
# This must be the backend's **public** Railway domain (Settings → Networking →
# Public Networking). A `*.railway.internal` hostname resolves only inside the
# Railway project, and the clients here are browsers and phones outside it — it
# would fail exactly like a dead host, only less obviously.
#
# https/wss are mandatory for the native apps: iOS App Transport Security and
# Android's cleartextTrafficPermitted=false both block plain http/ws, even on a
# LAN. See ../backend/DEPLOY.md.
VITE_BACKEND_URL=https://watch-london-move-production.up.railway.app
VITE_SOCKET_URL=https://watch-london-move-production.up.railway.app
VITE_INTERPOLATION_MS=12000
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
