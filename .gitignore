# Legacy 2010 site (archived under legacy/, tagged legacy-php-site)
*.pyc
/legacy/data/all-buses.json
/legacy/data/london.json
/legacy/data/london-text.json
/legacy/schematic/data
/legacy/bin/cache
/legacy/tfwm/data
/legacy/tfwm/bin/cache
/legacy/tfwm/bin/config.py

# New client/server apps
/node_modules
/backend/node_modules
/frontend/node_modules
/.env
!/.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example
/frontend/.env
/frontend/.env.*
!/frontend/.env.example
!/frontend/.env.production
/backend/.cache

# The Capacitor ios/ and android/ trees are source and are committed. Their
# build output, copied web assets and per-machine state are covered by the
# .gitignore Capacitor generates inside each of them.
/frontend/dist

# Release pipeline (see RELEASING.md): fastlane build output and the Android
# signing material CI materializes from secrets.
/build
/fastlane/report.xml
/frontend/android/key.properties
/frontend/android/app/upload-keystore.jks

# Vercel CLI state. Created by `vercel link` locally, and by web.yml in CI when
# it assembles the Build Output — neither belongs in the repo.
/.vercel
/frontend/.vercel

# Store artwork samples (not release assets)
store/samples/
store/samples-arrow/
store/samples-flow/
store/samples-type/
