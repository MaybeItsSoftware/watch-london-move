# CI/CD deploy secrets — copy to ./.env (gitignored), fill in, then push to
# GitHub Actions with ./scripts/set-github-secrets.sh.
#
# All of these are the org-shared maybeitssoftware values (same as
# open-parliament's .env) — see RELEASING.md.
#
# Rules that have cost real CI runs:
#  - NO quotes around values (they get pushed verbatim and break auth).
#  - APP_STORE_CONNECT_API_KEY_CONTENT is the base64 of the FULL .p8 including
#    its -----BEGIN/END PRIVATE KEY----- armor.

# iOS signing (fastlane match) + App Store Connect API
MATCH_PASSWORD=
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_CONTENT=

# Android upload signing (shared org keystore)
ANDROID_KEYSTORE_BASE64=
KEYSTORE_PASSWORD=
KEY_ALIAS=maybeitssoftware-gh-actions
KEY_PASSWORD=

# Google Play API (centralized service account, invited per-app in Play Console)
PLAY_STORE_SERVICE_ACCOUNT_JSON=

# Set separately (not via this file): MATCH_GIT_SSH_KEY — the read-only deploy
# key for the match-certs repo:
#   gh secret set MATCH_GIT_SSH_KEY < path/to/deploy_key
